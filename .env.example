# Data source: "fixture" (default, no network) or "live" (real Merge Agent Handler)
DATA_SOURCE=fixture

# Which persona fixture to use when DATA_SOURCE=fixture (or as live fallback)
FIXTURE_PERSONA=homebody

# Merge Agent Handler — server-side only, never exposed to the browser.
# The MCP endpoint is POST {BASE}/api/v1/tool-packs/{TOOL_PACK_ID}/registered-users/{USER_ID}/mcp/
# so the tool pack + registered user ids are required alongside the key.
MERGE_AGENT_HANDLER_KEY=
MERGE_TOOL_PACK_ID=
MERGE_REGISTERED_USER_ID=
# Optional; defaults to https://ah-api.merge.dev
MERGE_AGENT_HANDLER_BASE_URL=
# Optional; otherwise the *list_events tool is discovered via tools/list
MERGE_CALENDAR_TOOL_NAME=

# Separate public integration lab at /merge-demo.
# Google OAuth callback:
#   http://localhost:3000/api/auth/callback/google
# Add the deployed HTTPS equivalent in Google Cloud before production use.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required behind a production proxy; must be the canonical public HTTPS origin,
# e.g. https://shepard.example. Local direct development may leave it blank.
NEXTAUTH_URL=

# HMAC/encryption secret used to pseudonymize Google user ids and seal the
# HttpOnly Merge-user handle. Generate independently from AUTH_SECRET; 32+ chars.
MERGE_USER_ID_SECRET=

# Merge Gateway (OpenAI-compatible LLM proxy) — server-side only.
# Defaults to https://api-gateway.merge.dev/v1/openai
MERGE_GATEWAY_KEY=
MERGE_GATEWAY_BASE_URL=
MERGE_GATEWAY_MODEL=gpt-5.2
